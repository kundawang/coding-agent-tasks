diff --git a/src/retry.js b/src/retry.js
new file mode 100644
index 0000000..5b6c7d8
--- /dev/null
+++ b/src/retry.js
@@ -0,0 +1,12 @@
+export function retry(times, fn) {
+  let lastError;
+  for (let i = 0; i < times; i += 1) {
+    try {
+      return fn(i);
+    } catch (err) {
+      lastError = err;
+    }
+  }
+  throw lastError;
+}
